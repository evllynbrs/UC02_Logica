programa {
  funcao inicio() {
    real caloriasSalgados, caloriasSuco, caloriasTotal
    escreva ("Qual é a quantidade de calorias do salgado? ")
    leia (caloriasSalgados)
    escreva("Qual é a quantidade de calorias do suco? ")
    leia (caloriasSuco)
    caloriasTotal = (caloriasSalgados + caloriasSuco)
    escreva ("O estudande irá ingerir o total de ", caloriasTotal," calorias")
  }
}
