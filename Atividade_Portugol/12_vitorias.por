programa {
  funcao inicio() {
    real vitorias, pontos, total
    escreva ("Qual foi a quantidade de vitórias? ")
    leia(vitorias)
    escreva ("Quantos pontos vale cada vitória? ")
    leia (pontos)
    total = (vitorias * pontos)
    escreva("A quantidade de pontuação acumulada foi de ", total)
  }
}
