programa {
  funcao inicio() {
    real picole, comissao, total
    escreva("Quantos picolés você vendeu? ")
    leia (picole)
    escreva ("Qual é o valor da sua comissão? R$")
    leia (comissao)
    total = (picole * comissao)
    escreva ("O valor total da sua comissão será de R$", total)
  }
}
