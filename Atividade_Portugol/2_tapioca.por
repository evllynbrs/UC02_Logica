programa {
  funcao inicio() {
    real valorDaTapioca, quantidadeDeTapioca, valorTotal
    escreva ("Qual é o valor do combo da tapioca? R$")
    leia(valorDaTapioca)
    escreva ("Qual é a quantidade? ")
    leia(quantidadeDeTapioca)
    valorTotal = valorDaTapioca * quantidadeDeTapioca
    escreva("O valor das tapiocas é de: R$", valorTotal)
  }
}
