programa {
  funcao inicio() {
    real numeroDeTorcedoresPagantes, quantidadeDeTorcedoresPagantes, quantidadeTotal
    escreva ("Qual é a quantidade de trocedores pagantes nas arquibancadas? ")
    leia (numeroDeTorcedoresPagantes)
    escreva("Qual é a quantidade de torcedores pagantes nas cadeiras especias? ")
    leia(quantidadeDeTorcedoresPagantes)
    quantidadeTotal = numeroDeTorcedoresPagantes + quantidadeDeTorcedoresPagantes
    escreva ("A quantidade total de torcedores é ", quantidadeTotal)
  }
}
