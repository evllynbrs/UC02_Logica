programa {
  funcao inicio() {
    real valorDoSorvete, quantidadeDeSacolas, desconto
    escreva ("Qual é o valor do pote de sorvete? R$")
    leia(valorDoSorvete)
    escreva ("Qual foi a quantidade de sacolas reutilizáveis que cliente trouxe? ")
    leia (quantidadeDeSacolas)
    desconto = (valorDoSorvete - quantidadeDeSacolas)
    escreva ("O desconto dado para o/a cliente será de R$", quantidadeDeSacolas)
  }
}
