programa {

  funcao inicio() {
    escreva("------------- Ficha Cadastral -------------","\n")
    cadeia nome = "Homem Aranha"
    inteiro idade = 35
    caracter sexo = 'M'
    logico status = verdadeiro 
    real  salario = 3500.45
    real calculo = (5 + 7) / 2
    escreva(
      "Nome: ", nome, "\n",
      "Idade: ", idade, "\n",
      "Sexo: ", sexo, "\n",
      "Status: ", status, "\n",
      "Salário: ", salario, "\n",
      "o resultado é: ", calculo
    )
  }
}